  "urlatr": {
    "group": "Links",
    "category": "Links",
    "tag_name": "urlatr",
    "purpose": "Creates a clickable link with label",
    "syntax": "<URLATR='label', 'url'>",
    "min_args": 2,
    "max_args": 2,
    "args": [
      {"position": 1, "name": "label", "validate": ["tobj_html"], "regex": null, "required": true},
      {"position": 2, "name": "url", "validate": ["url"], "regex": "RE_URL_PATTERN", "required": true}
    ],
    "html": "<div style=\"margin-left: var(--Lsafe-margin) !important; margin-right: var(--Rsafe-margin) !important;\"><a href=\"{arg2}\" class=\"book-link\" rel=\"noopener noreferrer\">{arg1}</a></div>",
    "handler": null,
    "type": null,
    "allowed_content": "Label with TOBj/HTML, valid URL",
    "restrictions": "URL must be valid format",
    "defaults": {},
    "examples": ["<URLATR='{[_bold]} [[Click here]]', 'https://example.com'>"],
    "result": "Styled link with clickable label",
    "rules": "Label supports TOBj/HTML. URL must be valid.",
    "errors": "Error if URL is invalid"
  },

  "bbl_txt": {
    "group": "Interactive Content",
    "category": "Interactive Content",
    "tag_name": "bbl_txt",
    "purpose": "Direct BubbleText popup with full control",
    "syntax": "<BBL-Txt='direction', 'icon', 'top', 'left', 'bottom_gap', 'height', 'width', 'maxheight', 'maxwidth', 'position', 'textalign', 'content'>",
    "min_args": 0,
    "max_args": 12,
    "args": [
      {"position": 1, "name": "direction", "validate": ["direction"], "regex": "RE_DIRECTION_PATTERN", "required": false},
      {"position": 2, "name": "icon", "validate": ["text"], "regex": null, "required": false},
      {"position": 3, "name": "top", "validate": ["css_size_or_auto"], "regex": "RE_CSS_SIZE_OR_AUTO_PATTERN", "required": false},
      {"position": 4, "name": "left", "validate": ["css_size_or_auto"], "regex": "RE_CSS_SIZE_OR_AUTO_PATTERN", "required": false},
      {"position": 5, "name": "bottom_gap", "validate": ["css_size"], "regex": "RE_CSS_SIZE_PATTERN", "required": false},
      {"position": 6, "name": "height", "validate": ["css_size_or_auto"], "regex": "RE_CSS_SIZE_OR_AUTO_PATTERN", "required": false},
      {"position": 7, "name": "width", "validate": ["css_size_or_auto"], "regex": "RE_CSS_SIZE_OR_AUTO_PATTERN", "required": false},
      {"position": 8, "name": "maxheight", "validate": ["text"], "regex": null, "required": false},
      {"position": 9, "name": "maxwidth", "validate": ["text"], "regex": null, "required": false},
      {"position": 10, "name": "position", "validate": ["position"], "regex": "RE_POSITION_PATTERN", "required": false},
      {"position": 11, "name": "textalign", "validate": ["textalign"], "regex": "RE_TEXTALIGN_PATTERN", "required": false},
      {"position": 12, "name": "content", "validate": ["html_no_tobj"], "regex": null, "required": false}
    ],
    "html": null,
    "handler": "build_flexbot_span",
    "type": null,
    "allowed_content": "Popup supports HTML but NOT TOBj",
    "restrictions": "Content cannot contain TOBj",
    "defaults": {"direction": "floatboth", "icon": "🔹", "top": "auto", "left": "auto", "bottom_gap": "0vh", "height": "auto", "width": "auto", "position": "center-both", "textalign": "left"},
    "examples": ["<BBL-Txt='floatcenter', '💬', 'auto', 'auto', '0vh', '50%', '30%', '', '', 'center-both', 'left', '<b>Bold</b> popup'>"],
    "result": "Fully customizable popup",
    "rules": "Content accepts HTML but not TOBj.",
    "errors": "Error if content contains TOBj"
  },
  "clickwordl": {
    "group": "Interactive Content",
    "category": "Interactive Content",
    "tag_name": "clickwordl",
